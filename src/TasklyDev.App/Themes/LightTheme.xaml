<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#EFF1F6</Color>
    <Color x:Key="WindowSurfaceColor">#F7F9FD</Color>
    <Color x:Key="CardSurfaceColor">#FFFFFF</Color>
    <Color x:Key="SubtleSurfaceColor">#F2F4F8</Color>
    <Color x:Key="PrimaryTextColor">#191C1F</Color>
    <Color x:Key="SecondaryTextColor">#665E49</Color>
    <Color x:Key="MutedTextColor">#8A92A2</Color>
    <Color x:Key="AmberColor">#F5B942</Color>
    <Color x:Key="AmberDeepColor">#7C5800</Color>
    <Color x:Key="AmberTintColor">#FFF4DA</Color>
    <Color x:Key="OutlineColor">#E0E2E6</Color>
    <Color x:Key="ErrorColor">#BA1A1A</Color>
    <Color x:Key="EditorSurfaceColor">#FFFBF7</Color>
    <Color x:Key="CardOutlineColor">#F0F2F6</Color>
    <Color x:Key="DangerSurfaceColor">#FFFFEDEC</Color>
    <Color x:Key="WarmOutlineColor">#F3E4C4</Color>
    <Color x:Key="CardHoverColor">#FFFFFCF5</Color>
    <Color x:Key="SuccessSurfaceColor">#E8F7F1</Color>
    <Color x:Key="SuccessColor">#36A77A</Color>
    <Color x:Key="SuccessTextColor">#287A5A</Color>
    <Color x:Key="PreviewOverlayColor">#CCFFFFFF</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="{DynamicResource WindowSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{DynamicResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{DynamicResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{DynamicResource AmberColor}" />
    <SolidColorBrush x:Key="AmberDeepBrush" Color="{DynamicResource AmberDeepColor}" />
    <SolidColorBrush x:Key="AmberTintBrush" Color="{DynamicResource AmberTintColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{DynamicResource OutlineColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="{DynamicResource EditorSurfaceColor}" />
    <SolidColorBrush x:Key="CardOutlineBrush" Color="{DynamicResource CardOutlineColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{DynamicResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="WarmOutlineBrush" Color="{DynamicResource WarmOutlineColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{DynamicResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{DynamicResource SuccessTextColor}" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="{DynamicResource PreviewOverlayColor}" />

    <Style x:Key="SidebarNavigationButton" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolCardButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryActionButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
