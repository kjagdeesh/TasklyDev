<UserControl x:Class="TasklyDev.Views.GuidGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="GuidActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GuidPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource GuidActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="GuidCopyButton" TargetType="Button" BasedOn="{StaticResource GuidActionButton}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="GuidQuantityEditor" TargetType="TextBox">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GuidUppercaseCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckContainer"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CheckIndicator"
                                        Width="17"
                                        Height="17"
                                        CornerRadius="5"
                                        Background="{DynamicResource CardSurfaceBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Data="M 3 8 L 6.5 11.5 L 13 4.5"
                                          Width="11"
                                          Height="9"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource PrimaryTextBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckContainer" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIndicator" Property="Background" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="CheckIndicator" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckContainer" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter TargetName="CheckContainer" Property="BorderBrush" Value="{DynamicResource WarmOutlineBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckContainer" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="GuidRowTemplate">
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    CornerRadius="12"
                    Padding="12,9"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding}"
                               FontFamily="Consolas"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding}" />
                    <Button Grid.Column="1"
                            Content="Copy"
                            Margin="12,0,0,0"
                            Style="{StaticResource GuidCopyButton}"
                            Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            ToolTip="Copy this GUID"
                            AutomationProperties.Name="Copy GUID" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="GUID format"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <TextBlock DockPanel.Dock="Right"
                                       Text="Maximum 500 per batch"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <TextBlock Text="Choose the standard .NET Guid string representation."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                </DockPanel>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Height="36"
                              ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat}"
                              AutomationProperties.Name="GUID output format" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FormatDescription}"
                               Margin="14,0,0,0"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Quantity"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource GuidQuantityEditor}"
                                     AutomationProperties.Name="GUID quantity" />
                        </StackPanel>
                        <TextBlock Text="(1–500)"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,13,16,0" />
                        <CheckBox Content="Uppercase output"
                                  IsChecked="{Binding Uppercase}"
                                  VerticalAlignment="Center"
                                  Margin="0,13,0,0"
                                  Style="{StaticResource GuidUppercaseCheckBox}"
                                  AutomationProperties.Name="Uppercase GUID output" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource GuidActionButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="Generate GUIDs"
                            Command="{Binding GenerateCommand}"
                            Style="{StaticResource GuidPrimaryActionButton}"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border CornerRadius="13"
                Padding="14,10"
                Margin="0,0,0,16"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource AmberDeepBrush}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultHeading}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="GUIDs are identifiers, not passwords or secrets."
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Copy all"
                            Width="200"
                            Command="{Binding CopyAllCommand}"
                            Style="{StaticResource GuidPrimaryActionButton}"
                            VerticalAlignment="Center" />
                </DockPanel>

                <Border Padding="18"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        CornerRadius="12"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="No GUIDs generated yet. Choose a format and quantity, then select Generate GUIDs."
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </Border>
                <ScrollViewer MaxHeight="390"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Values}"
                                  ItemTemplate="{StaticResource GuidRowTemplate}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
