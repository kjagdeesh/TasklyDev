<UserControl x:Class="TasklyDev.Views.GuidGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <DataTemplate x:Key="GuidRowTemplate">
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    CornerRadius="12"
                    Padding="12,9"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding}"
                               FontFamily="Consolas"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding}" />
                    <Button Grid.Column="1"
                            Content="Copy"
                            Padding="10,5"
                            Margin="12,0,0,0"
                            Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            ToolTip="Copy this GUID"
                            AutomationProperties.Name="Copy GUID" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="GUID format"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <TextBlock DockPanel.Dock="Right"
                                       Text="Maximum 500 per batch"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <TextBlock Text="Choose the standard .NET Guid string representation."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                </DockPanel>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Height="36"
                              ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat}"
                              AutomationProperties.Name="GUID output format" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FormatDescription}"
                               Margin="14,0,0,0"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Quantity"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="72"
                                 Height="34"
                                 Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="GUID quantity" />
                        <TextBlock Text="1–500"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,16,0" />
                        <CheckBox Content="UPPERCASE"
                                  IsChecked="{Binding Uppercase}"
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  AutomationProperties.Name="Uppercase GUID output" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="Generate GUIDs"
                            Command="{Binding GenerateCommand}"
                            Background="{DynamicResource AmberBrush}"
                            BorderBrush="{DynamicResource AmberBrush}"
                            FontWeight="SemiBold"
                            Style="{StaticResource SecondaryActionButton}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border CornerRadius="13"
                Padding="14,10"
                Margin="0,0,0,16"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource AmberDeepBrush}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultHeading}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="GUIDs are identifiers, not passwords or secrets."
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Copy all"
                            Command="{Binding CopyAllCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            Background="{DynamicResource AmberBrush}"
                            BorderBrush="{DynamicResource AmberBrush}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                </DockPanel>

                <Border Padding="18"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        CornerRadius="12"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="No GUIDs generated yet. Choose a format and quantity, then select Generate GUIDs."
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </Border>
                <ScrollViewer MaxHeight="390"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Values}"
                                  ItemTemplate="{StaticResource GuidRowTemplate}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
