<UserControl x:Class="TasklyDev.Views.UnixTimestampView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:TasklyDev.Core.Time;assembly=TasklyDev.Core"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="TimestampActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimestampPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource TimestampActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="TimestampCopyButton" TargetType="Button" BasedOn="{StaticResource TimestampActionButton}">
            <Setter Property="Width" Value="64" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TimestampFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="ModeRadioButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource AmberBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimestampEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Timestamp → Date"
                                 GroupName="TimestampMode"
                                 IsChecked="{Binding IsTimestampMode, Mode=TwoWay}"
                                 Style="{StaticResource ModeRadioButton}"
                                 AutomationProperties.Name="Timestamp to date mode" />
                    <RadioButton Content="Date → Timestamp"
                                 GroupName="TimestampMode"
                                 IsChecked="{Binding IsDateMode, Mode=TwoWay}"
                                 Style="{StaticResource ModeRadioButton}"
                                 AutomationProperties.Name="Date to timestamp mode" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Now"
                            Command="{Binding NowCommand}"
                            Style="{StaticResource TimestampPrimaryActionButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Load sample"
                            Command="{Binding LoadSampleCommand}"
                            Style="{StaticResource TimestampActionButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource TimestampActionButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border CornerRadius="13"
                Padding="14,10"
                Margin="0,0,0,16"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource AmberDeepBrush}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20"
                    Visibility="{Binding IsTimestampMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Timestamp to date"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Unix epoch value · unit must be selected explicitly"
                               Margin="0,5,0,18"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Timestamp value"
                               Style="{StaticResource TimestampFieldLabel}"
                               Margin="0,0,0,7" />
                    <TextBox Text="{Binding TimestampInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TimestampEditor}"
                             AutomationProperties.Name="Unix timestamp value" />
                    <TextBlock Text="Unit"
                               Style="{StaticResource TimestampFieldLabel}"
                               Margin="0,16,0,7" />
                    <ComboBox Height="36"
                              SelectedValue="{Binding SelectedUnit}"
                              SelectedValuePath="Tag"
                              AutomationProperties.Name="Unix timestamp unit">
                        <ComboBoxItem Content="Seconds (s)" Tag="{x:Static core:UnixTimestampUnit.Seconds}" />
                        <ComboBoxItem Content="Milliseconds (ms)" Tag="{x:Static core:UnixTimestampUnit.Milliseconds}" />
                    </ComboBox>
                    <Button Content="Convert timestamp"
                            Command="{Binding ConvertTimestampCommand}"
                            Style="{StaticResource TimestampPrimaryActionButton}"
                            HorizontalAlignment="Left"
                            Margin="0,18,0,0" />
                    <TextBlock Text="UTC is used internally; local time is shown separately."
                               Margin="0,14,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20"
                    Visibility="{Binding IsDateMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Date to timestamp"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="ISO 8601 date/time with an explicit Z or numeric offset"
                               Margin="0,5,0,18"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Date and time"
                               Style="{StaticResource TimestampFieldLabel}"
                               Margin="0,0,0,7" />
                    <TextBox Text="{Binding DateTimeInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TimestampEditor}"
                             ToolTip="Example: 2024-06-11T11:34:40+00:00"
                             AutomationProperties.Name="ISO 8601 date and time with explicit offset" />
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,16,0,0">
                        <TextBlock Text="Examples: 2024-06-11T11:34:40Z · 2024-06-11T17:04:40+05:30. Offset is required; the app never assumes a time zone."
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Button Content="Convert date"
                            Command="{Binding ConvertDateCommand}"
                            Style="{StaticResource TimestampPrimaryActionButton}"
                            HorizontalAlignment="Left"
                            Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2"
                        Visibility="{Binding IsTimestampMode, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{DynamicResource AmberTintBrush}"
                        BorderBrush="{DynamicResource WarmOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,13">
                            <TextBlock Text="UTC result"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="ISO 8601 · UTC"
                                       FontSize="11"
                                       Padding="10,4,0,0"
                                       Foreground="{DynamicResource AmberDeepBrush}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding UtcResult, Mode=OneWay}"
                                     Style="{StaticResource TimestampEditor}"
                                     IsReadOnly="True"
                                     Background="{DynamicResource CardSurfaceBrush}"
                                     AutomationProperties.Name="UTC date result" />
                            <Button Content="Copy"
                                    Grid.Column="1"
                                    Command="{Binding CopyUtcCommand}"
                                    Style="{StaticResource TimestampCopyButton}"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,13">
                            <TextBlock Text="Local machine time"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding LocalTimeZoneLabel}"
                                       FontSize="11"
                                       Padding="10,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding LocalResult, Mode=OneWay}"
                                     Style="{StaticResource TimestampEditor}"
                                     IsReadOnly="True"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     AutomationProperties.Name="Local machine date result" />
                            <Button Content="Copy"
                                    Grid.Column="1"
                                    Command="{Binding CopyLocalCommand}"
                                    Style="{StaticResource TimestampCopyButton}"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20"
                    Visibility="{Binding IsDateMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Unix timestamp results"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Both units shown explicitly"
                                   DockPanel.Dock="Right"
                                   FontSize="11"
                                   Padding="10,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Unix seconds"
                                       Style="{StaticResource TimestampFieldLabel}"
                                       Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SecondsResult, Mode=OneWay}"
                                         Style="{StaticResource TimestampEditor}"
                                         IsReadOnly="True"
                                         Background="{DynamicResource SubtleSurfaceBrush}"
                                         AutomationProperties.Name="Unix timestamp in seconds" />
                                <Button Content="Copy"
                                        Grid.Column="1"
                                        Command="{Binding CopySecondsCommand}"
                                        Style="{StaticResource TimestampCopyButton}"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unix milliseconds"
                                       Style="{StaticResource TimestampFieldLabel}"
                                       Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding MillisecondsResult, Mode=OneWay}"
                                         Style="{StaticResource TimestampEditor}"
                                         IsReadOnly="True"
                                         Background="{DynamicResource SubtleSurfaceBrush}"
                                         AutomationProperties.Name="Unix timestamp in milliseconds" />
                                <Button Content="Copy"
                                        Grid.Column="1"
                                        Command="{Binding CopyMillisecondsCommand}"
                                        Style="{StaticResource TimestampCopyButton}"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,16,0,0">
                        <TextBlock Text="UTC"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AmberDeepBrush}" />
                        <TextBlock Text="{Binding UtcResult}"
                                   Margin="9,2,0,0"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalTimeZoneLabel}"
                                   DockPanel.Dock="Right"
                                   FontSize="11"
                                   Margin="15,1,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="{DynamicResource SubtleSurfaceBrush}"
                CornerRadius="12"
                Padding="12"
                Margin="0,14,0,0">
            <TextBlock Text="Unix time counts whole seconds or milliseconds from 1970-01-01T00:00:00Z and does not represent leap seconds."
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
