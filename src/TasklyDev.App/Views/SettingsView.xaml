<UserControl x:Class="TasklyDev.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <StackPanel>
        <TextBlock Text="Appearance"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="2,0,0,10" />
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Theme"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7" />
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          Padding="10,8"
                          MaxWidth="260"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="Application theme" />
                <TextBlock Text="System follows your Windows app appearance. Theme changes apply immediately and are not saved after closing."
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0" />
                <Border Style="{StaticResource RoundedStatusMessageBorder}"
                        Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="About"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="2,0,0,10" />
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20">
            <StackPanel>
                <Image x:Name="SettingsBrandLogo"
                       Width="108"
                       Height="108"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Loaded="SettingsBrandLogo_Loaded"
                       AutomationProperties.Name="Taskly.dev logo" />
                <TextBlock VerticalAlignment="Center"
                           Margin="0,15,5,15"
                           FontSize="21"
                           FontWeight="Bold">
                    <Run Text="taskly" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <Run Text=".dev" Foreground="{DynamicResource AmberBrush}" />
                </TextBlock>
                <!--<TextBlock Text="{Binding ProductName}"
                           FontSize="19"
                           FontWeight="Bold"
                           Margin="0,13,0,2" />-->
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}">
                    <Run Text="Version " />
                    <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,3,0,0">
                    <Run Text="Runtime: " />
                    <Run Text="{Binding RuntimeVersion, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="Privacy"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,18,0,5" />
                <TextBlock Text="{Binding PrivacyStatement}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Third-party notices"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,16,0,5" />
                <TextBlock Text="{Binding LicenseStatement}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
