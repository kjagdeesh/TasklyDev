<UserControl x:Class="TasklyDev.Views.DotNetInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             IsVisibleChanged="DotNetInspectorView_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="DotNetActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DotNetPrimaryButton" TargetType="Button" BasedOn="{StaticResource DotNetActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="126" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource WarmOutlineBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DotNetOutput" TargetType="TextBox">
            <Setter Property="MinHeight" Value="100" />
            <Setter Property="MaxHeight" Value="230" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="OutputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OutputBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OutputBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource AmberTintBrush}"
                BorderBrush="{DynamicResource WarmOutlineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="15"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Machine-wide .NET installation discovery"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AmberDeepBrush}" />
                <TextBlock Text="Lists SDKs, runtimes, and workloads available to this user. It does not inspect a selected project, resolve a project's global.json, or install/change any SDK."
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InspectionScope}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InspectedAt, StringFormat=Last inspected: {0:yyyy-MM-dd HH:mm:ss zzz}, TargetNullValue=Not inspected yet}"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource DotNetPrimaryButton}"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0"
                        ToolTip="Discover installed SDKs, runtimes, and workloads again"
                        AutomationProperties.Name="Refresh .NET installation details">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Refresh" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="Refreshing..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Installed SDKs"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right"
                               Padding="15,4,0,0"
                               Text="{Binding Sdks.Count, StringFormat={}{0} found}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
                <TextBlock Text="No SDKs were reported by dotnet --list-sdks."
                           Visibility="{Binding HasNoSdks, Converter={StaticResource BoolToVisibility}}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Sdks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Version}"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InstallPath}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Installed runtimes"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right"
                               Padding="15,4,0,0"
                               Text="{Binding Runtimes.Count, StringFormat={}{0} found}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
                <TextBlock Text="No runtimes were reported by dotnet --list-runtimes."
                           Visibility="{Binding HasNoRuntimes, Converter={StaticResource BoolToVisibility}}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Runtimes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Version}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding InstallPath}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Workloads"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <TextBlock Text="No workload details were returned. Review the command diagnostics below."
                           Visibility="{Binding HasNoWorkloadOutput, Converter={StaticResource BoolToVisibility}}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,8" />
                <TextBox Text="{Binding WorkloadOutput, Mode=OneWay}"
                         Style="{StaticResource DotNetOutput}"
                         AutomationProperties.Name="Installed .NET workload command output" />
            </StackPanel>
        </Border>

        <Expander Header="Installation and host details"
                  IsExpanded="False"
                  Margin="0,0,0,12">
            <Border Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,10,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Resolved dotnet host"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DotNetPath}"
                               Margin="0,4,0,12"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="dotnet --info"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding InfoOutput, Mode=OneWay}"
                             Style="{StaticResource DotNetOutput}"
                             AutomationProperties.Name="dotnet info output" />
                </StackPanel>
            </Border>
        </Expander>

        <Expander Header="Command diagnostics"
                  IsExpanded="False">
            <Border Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,10,0,0"
                    Padding="16">
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Command}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               FontSize="11" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ExitCode, TargetNullValue=—}"
                                               FontFamily="Consolas"
                                               FontSize="11" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Duration, StringFormat={}{0.TotalSeconds:F2}s}"
                                               FontSize="11" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Details}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>
