<UserControl x:Class="TasklyDev.Views.ProcessLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ProcessGridColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ProcessGridRow" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Running processes"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Search by process name or exact process ID. Data is read-only and stays on this device."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Refresh snapshot"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="14,0,0,0"
                            Padding="14,9"
                            Background="{DynamicResource AmberBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            AutomationProperties.Name="Refresh process snapshot" />
                </DockPanel>

                <TextBlock Text="Search"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,18,0,7" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="42"
                         Padding="11,9"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         Background="{DynamicResource EditorSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderBrush="{DynamicResource OutlineBrush}"
                         BorderThickness="1"
                         AutomationProperties.Name="Search process name or exact process ID" />

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,10,0,0"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="4"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <ListView ItemsSource="{Binding Processes}"
                      ItemContainerStyle="{StaticResource ProcessGridRow}"
                      BorderThickness="0"
                      MaxHeight="540"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Running process results">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource ProcessGridColumnHeader}">
                        <GridViewColumn Header="Process name" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="PID" Width="82" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="Start time" Width="170" DisplayMemberBinding="{Binding StartTime}" />
                        <GridViewColumn Header="Executable path" Width="440">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExecutablePath}"
                                               ToolTip="{Binding ExecutablePath}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="420"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                CornerRadius="14"
                Padding="18"
                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No processes match this search."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Border>

        <Border Background="{DynamicResource AmberTintBrush}"
                CornerRadius="10"
                Padding="12,9"
                Margin="0,14,0,0">
            <TextBlock Text="Some start times or executable paths may be unavailable because of access restrictions or processes exiting during collection. TasklyDev does not request elevation."
                       Foreground="{DynamicResource AmberDeepBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
