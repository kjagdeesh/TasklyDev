<UserControl x:Class="TasklyDev.Views.GuidParserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ParserActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ParserPrimaryButton" TargetType="Button" BasedOn="{StaticResource ParserActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Validate and parse a UUID / GUID"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Paste a value to check its .NET format, normalize it, and inspect recognizable UUID version bits."
                           Margin="0,5,0,18"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="UUID / GUID value"
                           Margin="0,0,0,6"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="44"
                         Padding="12,10"
                         FontFamily="Consolas"
                         FontSize="14"
                         Background="{DynamicResource EditorSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderBrush="{DynamicResource OutlineBrush}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="UUID or GUID input" />

                <TextBlock Text="Accepted .NET formats: D, N, B, P, and X."
                           Margin="0,7,0,16"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource ParserActionButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Validate and parse"
                            Command="{Binding ParseCommand}"
                            Style="{StaticResource ParserPrimaryButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border CornerRadius="13"
                Padding="14,10"
                Margin="0,0,0,16"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource AmberDeepBrush}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Inspection result"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Detected format"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding DetectedFormat, TargetNullValue=Unavailable}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="UUID version"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding VersionDescription}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Canonical value"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource EditorSurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CanonicalValue}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Canonical UUID or GUID value" />
                    </Border>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Command="{Binding CopyCanonicalCommand}"
                            IsEnabled="{Binding IsValid}"
                            Style="{StaticResource ParserActionButton}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Copy canonical UUID or GUID" />
                </Grid>

                <TextBlock Text="Version reporting is based only on recognizable RFC variant and version bits. It does not prove a value's origin, uniqueness, or security."
                           Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
