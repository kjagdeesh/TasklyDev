<UserControl x:Class="TasklyDev.Views.HashCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="HashActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HashPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource HashActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="HashCopyButton" TargetType="Button" BasedOn="{StaticResource HashActionButton}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="HashTextEditor" TargetType="TextBox">
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HashResultEditor" TargetType="TextBox" BasedOn="{StaticResource HashTextEditor}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style x:Key="HashFileEditor" TargetType="TextBox" BasedOn="{StaticResource HashResultEditor}">
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        </Style>
        <Style x:Key="HashFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <DataTemplate x:Key="HashResultTemplate">
            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Algorithm}"
                               Width="82"
                               Style="{StaticResource HashFieldLabel}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding HexValue, Mode=OneWay}"
                             Style="{StaticResource HashResultEditor}"
                             AutomationProperties.Name="{Binding Algorithm}" />
                    <Button Grid.Column="2"
                            Content="Copy"
                            Margin="9,0,0,0"
                            Style="{StaticResource HashCopyButton}"
                            Command="{Binding DataContext.CopyDigestCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="Copy hash digest" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ModeRadioButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource AmberBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Message Digest Calculator"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Calculate local checksums for UTF-8 text or a file."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="30,0,0,0">
                        <RadioButton Content="Text"
                                     GroupName="HashInputMode"
                                     IsChecked="{Binding IsTextMode, Mode=TwoWay}"
                                     Style="{StaticResource ModeRadioButton}"
                                     AutomationProperties.Name="Hash text mode" />
                        <RadioButton Content="File"
                                     GroupName="HashInputMode"
                                     IsChecked="{Binding IsFileMode, Mode=TwoWay}"
                                     Style="{StaticResource ModeRadioButton}"
                                     AutomationProperties.Name="Hash file mode" />
                    </StackPanel>
                </DockPanel>

                <Grid Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock Text="Input text (UTF-8)"
                                   Style="{StaticResource HashFieldLabel}" />
                        <TextBlock DockPanel.Dock="Right" Margin="20,0,0,0"
                                   Text="{Binding InputByteCount, StringFormat={}{0} UTF-8 bytes}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                    <TextBox Grid.Row="1"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource HashTextEditor}"
                             MinHeight="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Text to hash" />
                </Grid>

                <Grid Visibility="{Binding IsFileMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Local file"
                                   Style="{StaticResource HashFieldLabel}"
                                   Margin="0,0,0,7" />
                        <TextBox Text="{Binding FilePath, Mode=OneWay}"
                                 Style="{StaticResource HashFileEditor}"
                                 ToolTip="{Binding FilePath}"
                                 AutomationProperties.Name="Selected file path" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding BrowseFileCommand}"
                            Style="{StaticResource HashActionButton}"
                            Margin="10,22,0,0"
                            AutomationProperties.Name="Browse for a file to hash" />
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Algorithm"
                               Style="{StaticResource HashFieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <ComboBox Grid.Column="1"
                              Height="34"
                              ItemsSource="{Binding Algorithms}"
                              SelectedItem="{Binding SelectedAlgorithm}"
                              AutomationProperties.Name="Hash algorithm" />
                    <Button Grid.Column="3"
                            Content="Calculate hashes"
                            Command="{Binding CalculateCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource HashPrimaryActionButton}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="4"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource HashActionButton}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="5"
                            Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource HashActionButton}" />
                </Grid>

                <TextBlock Text="MD5 is included for legacy checksum compatibility only. Do not use MD5 for security-sensitive integrity or password storage."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,13,0,0" />
            </StackPanel>
        </Border>

        <Border CornerRadius="13"
                Padding="14,10"
                Margin="0,0,0,16"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right"
                             Width="100"
                             Height="6"
                             IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource AmberDeepBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18">
            <StackPanel>
                <DockPanel Margin="0,0,0,13">
                    <TextBlock Text="{Binding ResultHeading}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Lowercase hexadecimal"
                               DockPanel.Dock="Right"
                               FontSize="11"
                               Margin="20,4,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
                <Border Padding="18"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        CornerRadius="12"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="No digest calculated yet. Choose an input and calculate to see the result."
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding Results}"
                              ItemTemplate="{StaticResource HashResultTemplate}"
                              Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
