<UserControl x:Class="TasklyDev.Views.ColorConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ColorActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ColorActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="ColorCopyButton" TargetType="Button" BasedOn="{StaticResource ColorActionButton}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ColorEditor" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <DrawingBrush x:Key="CheckerboardBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF"
                                     Geometry="M0,0 H16 V16 H0 Z" />
                    <GeometryDrawing Brush="#FFE8EAF0"
                                     Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0">
                    <TextBlock Text="Color Converter"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Convert between HEX, RGB, and HSL with alpha preserved."
                               Margin="0,4,0,16"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="Input format"
                               Style="{StaticResource ColorFieldLabel}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding InputFormats}"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                              Padding="8,7"
                              Margin="0,0,0,11"
                              AutomationProperties.Name="Color input format" />
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ColorEditor}"
                             AutomationProperties.Name="Color value input" />
                    <Border Style="{StaticResource RoundedStatusMessageBorder}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Choose color"
                                Command="{Binding PickColorCommand}"
                                IsEnabled="{Binding IsNotPickingColor}"
                                Margin="0,0,8,7"
                                Style="{StaticResource ColorPrimaryActionButton}"
                                AutomationProperties.Name="Choose a color" />
                        <Button Content="Load sample"
                                Command="{Binding LoadSampleCommand}"
                                Margin="0,0,8,7"
                                Style="{StaticResource ColorActionButton}" />
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Margin="0,0,0,7"
                                Style="{StaticResource ColorActionButton}" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Live preview"
                               Style="{StaticResource ColorFieldLabel}"
                               Margin="0,0,0,8" />
                    <Border Height="152"
                            Background="{StaticResource CheckerboardBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <Border Background="{Binding PreviewBrush}"
                                    CornerRadius="15" />
                            <Border CornerRadius="15"
                                    Background="{DynamicResource PreviewOverlayBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12,7"
                                    Visibility="{Binding HasColor, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding HexValue}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="The checkerboard preview shows transparent colors."
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Converted values"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="2,0,0,10" />
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HEX" Style="{StaticResource ColorFieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding HexValue, Mode=OneWay}"
                             IsReadOnly="True"
                             Style="{StaticResource ColorEditor}"
                             Background="{DynamicResource SubtleSurfaceBrush}"
                             AutomationProperties.Name="Converted HEX color" />
                    <Button Grid.Column="2"
                            Content="Copy"
                            Command="{Binding CopyHexCommand}"
                            Margin="9,0,0,0"
                            Style="{StaticResource ColorCopyButton}" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RGB" Style="{StaticResource ColorFieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding RgbValue, Mode=OneWay}"
                             IsReadOnly="True"
                             Style="{StaticResource ColorEditor}"
                             Background="{DynamicResource SubtleSurfaceBrush}"
                             AutomationProperties.Name="Converted RGB color" />
                    <Button Grid.Column="2"
                            Content="Copy"
                            Command="{Binding CopyRgbCommand}"
                            Margin="9,0,0,0"
                            Style="{StaticResource ColorCopyButton}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HSL" Style="{StaticResource ColorFieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding HslValue, Mode=OneWay}"
                             IsReadOnly="True"
                             Style="{StaticResource ColorEditor}"
                             Background="{DynamicResource SubtleSurfaceBrush}"
                             AutomationProperties.Name="Converted HSL color" />
                    <Button Grid.Column="2"
                            Content="Copy"
                            Command="{Binding CopyHslCommand}"
                            Margin="9,0,0,0"
                            Style="{StaticResource ColorCopyButton}" />
                </Grid>
                <TextBlock Text="Alpha policy: HEX appends AA (#RRGGBBAA); RGB alpha uses 0–255; HSL alpha uses 0–1."
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,13,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
