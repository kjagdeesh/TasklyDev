<UserControl x:Class="TasklyDev.Views.NumberBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberTintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="NumberEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="QUICK PAIRS"
                       Margin="0,0,12,0"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <WrapPanel>
                <Button Content="DEC → HEX" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="DEC_HEX" />
                <Button Content="HEX → DEC" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="HEX_DEC" />
                <Button Content="DEC → BIN" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="DEC_BIN" />
                <Button Content="BIN → HEX" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="BIN_HEX" />
                <Button Content="OCT → DEC" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="OCT_DEC" />
            </WrapPanel>
        </DockPanel>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Source input"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Base"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="94"
                                      Height="32"
                                      ItemsSource="{Binding Bases}"
                                      SelectedItem="{Binding SourceBase}"
                                      AutomationProperties.Name="Source number base" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Input value"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NumberEditor}"
                             MinHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Integer value to convert" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Load sample"
                                Command="{Binding LoadSampleCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SecondaryActionButton}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="18,0">
                    <Button Content="⇄"
                            Width="46"
                            Height="46"
                            Background="{DynamicResource AmberBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderThickness="0"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Command="{Binding SwapBasesCommand}"
                            ToolTip="Swap source and target bases"
                            AutomationProperties.Name="Swap source and target bases" />
                    <TextBlock Text="Swap bases"
                               Margin="0,7,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Converted output"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Base"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="94"
                                      Height="32"
                                      ItemsSource="{Binding Bases}"
                                      SelectedItem="{Binding TargetBase}"
                                      AutomationProperties.Name="Target number base" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Output value"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <TextBox Text="{Binding OutputText, Mode=OneWay}"
                             Style="{StaticResource NumberEditor}"
                             MinHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             Background="{DynamicResource SubtleSurfaceBrush}"
                             AutomationProperties.Name="Converted integer output" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Convert"
                                Command="{Binding ConvertCommand}"
                                Background="{DynamicResource AmberBrush}"
                                BorderBrush="{DynamicResource AmberBrush}"
                                FontWeight="SemiBold"
                                Style="{StaticResource SecondaryActionButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Copy output"
                                Command="{Binding CopyOutputCommand}"
                                Style="{StaticResource SecondaryActionButton}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border CornerRadius="13"
                Padding="14,10"
                Margin="0,14,0,0"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource AmberDeepBrush}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <TextBlock Text="Arbitrary precision via BigInteger. Digits 0–9 and A–Z are accepted; leading and trailing whitespace is ignored."
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="2,10,0,0"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
