<UserControl x:Class="TasklyDev.Views.NumberBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Loaded="NumberBaseView_Loaded"
             SizeChanged="NumberBaseView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="NumberBaseActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumberBasePrimaryButton" TargetType="Button" BasedOn="{StaticResource NumberBaseActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource NumberBaseActionButton}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberTintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="NumberEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="QUICK PAIRS"
                       Margin="0,0,12,0"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <WrapPanel>
                <Button Content="DEC → HEX" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="DEC_HEX" />
                <Button Content="HEX → DEC" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="HEX_DEC" />
                <Button Content="DEC → BIN" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="DEC_BIN" />
                <Button Content="BIN → HEX" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="BIN_HEX" />
                <Button Content="OCT → DEC" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="OCT_DEC" />
            </WrapPanel>
        </DockPanel>

        <Border CornerRadius="10"
                Padding="14,10"
                Margin="0,14,0,0"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
               FontSize="12"
               Foreground="{DynamicResource AmberDeepBrush}"
               TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <TextBlock Text="Arbitrary precision via BigInteger. Digits 0–9 and A–Z are accepted; leading and trailing whitespace is ignored."
           FontSize="11"
           Foreground="{DynamicResource MutedTextBrush}"
           Margin="2,10,0,20"
           TextWrapping="Wrap" />

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Source input"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="40"
                                    Padding="15,0"
                                    Margin="15,0,6,0">
                                <TextBlock Text="Base"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ComboBox Width="94"
                                      Height="32"
                                      ItemsSource="{Binding Bases}"
                                      SelectedItem="{Binding SourceBase}"
                                      AutomationProperties.Name="Source number base" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Load sample"
                                Command="{Binding LoadSampleCommand}"
                                Style="{StaticResource NumberBaseActionButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource WarningActionButton}" />
                    </StackPanel>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource CardOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="9,5"
                            Margin="0,0,0,7"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Input value"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                    <TextBox x:Name="InputEditor"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NumberEditor}"
                             MinHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             TextChanged="Editor_TextChanged"
                             AutomationProperties.Name="Integer value to convert" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="18,0">
                    <Button Content="⇄"
                            Width="46"
                            Height="46"
                            Background="{DynamicResource AmberBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource AmberBrush}"
                            BorderThickness="1"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding SwapBasesCommand}"
                            ToolTip="Swap source and target bases"
                            AutomationProperties.Name="Swap source and target bases">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SwapBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="23">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SwapBorder" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                        <Setter TargetName="SwapBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="SwapBorder" Property="Opacity" Value="0.82" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="SwapBorder" Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Swap bases"
                               Margin="0,7,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Converted output"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="40"
                                    Padding="15,0"
                                    Margin="15,0,6,0">
                                <TextBlock Text="Base"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ComboBox Width="94"
                                      Height="32"
                                      ItemsSource="{Binding Bases}"
                                      SelectedItem="{Binding TargetBase}"
                                      AutomationProperties.Name="Target number base" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Convert"
                                Command="{Binding ConvertCommand}"
                                Style="{StaticResource NumberBasePrimaryButton}"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0" />
                        <Button Content="Copy output"
                                Command="{Binding CopyOutputCommand}"
                                Style="{StaticResource NumberBaseActionButton}" />
                    </StackPanel>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource CardOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="9,5"
                            Margin="0,0,0,7"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Output value"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                    <TextBox x:Name="OutputEditor"
                             Text="{Binding OutputText, Mode=OneWay}"
                             Style="{StaticResource NumberEditor}"
                             MinHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             TextChanged="Editor_TextChanged"
                             IsReadOnly="True"
                             Background="{DynamicResource SubtleSurfaceBrush}"
                             AutomationProperties.Name="Converted integer output" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
