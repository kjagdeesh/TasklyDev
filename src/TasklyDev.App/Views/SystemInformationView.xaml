<UserControl x:Class="TasklyDev.Views.SystemInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             IsVisibleChanged="SystemInformationView_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="SystemInfoActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="SystemInfoPrimaryButton" TargetType="Button" BasedOn="{StaticResource SystemInfoActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource AmberTintBrush}"
                BorderBrush="{DynamicResource WarmOutlineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="15"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Read-only system snapshot"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AmberDeepBrush}" />
                <TextBlock Text="Collects read-only Windows, processor, firmware, graphics, memory, storage, security, and .NET details. Device IDs, Product IDs, and the current account may appear in copied or exported reports; values are not redacted."
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GeneratedAt, StringFormat=Generated: {0:yyyy-MM-dd HH:mm:ss zzz}, TargetNullValue=Not generated}"
                                   Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource SystemInfoPrimaryButton}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Copy summary"
                            Command="{Binding CopySummaryCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource SystemInfoActionButton}" />
                    <Button Content="Export TXT"
                            Command="{Binding ExportTextCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource SystemInfoActionButton}" />
                    <Button Content="Export JSON"
                            Command="{Binding ExportJsonCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource SystemInfoActionButton}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16"
                Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="At a glance"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding SummaryFields}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="165"
                                    MinHeight="76"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Value}"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16"
                Visibility="{Binding HasNoAvailableInformation, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="No system information is available"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="Field-level details below explain which sources could not be read."
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardSurfaceBrush}"
                            BorderBrush="{DynamicResource CardOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Value}"
                                                           Margin="0,5,0,0"
                                                           FontSize="12"
                                                           VerticalAlignment="Top"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Source, StringFormat=Source: {0}}"
                                                           Margin="0,6,0,0"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
