<UserControl x:Class="TasklyDev.Views.ClipboardHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TasklyDev.Views"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <local:ClipboardHistoryTitleConverter x:Key="ClipboardHistoryTitleConverter" />
        <local:ClipboardHistorySizeConverter x:Key="ClipboardHistorySizeConverter" />
        <Style x:Key="ClipboardHistoryButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardHistoryPrimaryButton" TargetType="Button" BasedOn="{StaticResource ClipboardHistoryButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="ClipboardHistoryClearSearchButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ClearButtonBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ClearButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardHistorySearchBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ClipboardHistorySortComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ClipboardHistoryTextEditor" TargetType="TextBox" BasedOn="{StaticResource ClipboardHistorySearchBox}">
            <Setter Property="MaxHeight" Value="360" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardHistoryBaseText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}" />
        <Style x:Key="ClipboardHistoryNoticeTitle" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryDescription" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="ClipboardHistorySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ClipboardHistoryFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ClipboardHistoryEntryText" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="ClipboardHistorySizeTag" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarmOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="ClipboardHistorySizeTagText" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryActionFeedbackText" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActionError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardHistoryActionFeedbackSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActionError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardHistoryPolicyHeading" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryPolicyLabel" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryPolicyValue" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryPolicyNoteHeading" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryPolicyNote" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryStatusText" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardHistoryCaption" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryCaptureState" TargetType="TextBlock" BasedOn="{StaticResource ClipboardHistoryBaseText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardHistoryCaptureCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AmberTintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardHistoryPolicyTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="ClipboardHistoryStorageProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}" />
        </Style>
        <Style x:Key="ClipboardHistoryConsentCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ConsentCheckBorder"
                                    Width="19"
                                    Height="19"
                                    CornerRadius="5"
                                    Background="{DynamicResource CardSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top"
                                    Margin="0,1,0,0">
                                <Path x:Name="ConsentCheckMark"
                                      Data="M3,9 L7,13 L15,4"
                                      Width="11"
                                      Height="11"
                                      Stretch="Uniform"
                                      Stroke="#3B2B0D"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ConsentCheckBorder" Property="Background" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ConsentCheckBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ConsentCheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ConsentCheckBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ConsentCheckBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardHistoryList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="MinHeight" Value="220" />
            <Setter Property="MaxHeight" Value="360" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0,0,11,11"
                                ClipToBounds="True">
                            <ScrollViewer Focusable="False"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardHistoryListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" ClipToBounds="True">
                        <Border x:Name="EntryBackground"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="0,0,0,1" />
                            <Border x:Name="SelectionMarker"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AmberBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="14,10,12,10"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EntryBackground" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="EntryBackground" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource AmberTintBrush}"
                BorderBrush="{DynamicResource WarmOutlineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="15"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Clipboard capture is off until you opt in"
                           Style="{StaticResource ClipboardHistoryNoticeTitle}" />
                <TextBlock Text="Only plain text is captured. Clipboard text may contain passwords, tokens, or private messages. Entries are encrypted for this Windows user using DPAPI and stored in a LocalAppData JSON file. The app does not log or upload clipboard contents. Closing the window hides TasklyDev to the tray and capture continues; choose Quit in the tray menu to stop the process."
                           Margin="0,5,0,0"
                           Style="{StaticResource ClipboardHistoryDescription}" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource ClipboardHistoryStatusText}" />
                        <TextBlock Text="{Binding LastUpdatedAt, StringFormat=Last updated: {0:yyyy-MM-dd HH:mm:ss zzz}, TargetNullValue=History not loaded}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource ClipboardHistoryCaption}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource ClipboardHistoryPrimaryButton}"
                            Width="130"
                            MinWidth="0"
                            Padding="9,7"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Reload encrypted clipboard history"
                            AutomationProperties.Name="Refresh clipboard history">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            
                            <TextBlock Text="Refresh history"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Border Style="{StaticResource ClipboardHistoryCaptureCard}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13"
                        Margin="0,14,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Capture state"
                                           Style="{StaticResource ClipboardHistoryCaption}" />
                                <TextBlock Text="{Binding CaptureState}"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource ClipboardHistoryCaptureState}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="200"
                                    Background="{DynamicResource CardSurfaceBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Storage"
                                               Style="{StaticResource ClipboardHistoryCaption}" />
                                    <TextBlock Text="{Binding StorageUsage}"
                                               Margin="0,3,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding StorageUsageMegabytes, Mode=OneWay}"
                                                 Style="{StaticResource ClipboardHistoryStorageProgressBar}"
                                                 Margin="0,8,0,0"
                                                 ToolTip="{Binding StorageUsage}"
                                                 AutomationProperties.Name="Clipboard history storage used out of 100 MB" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <CheckBox IsChecked="{Binding ConsentConfirmed, Mode=TwoWay}"
                                  IsEnabled="{Binding IsCaptureDisabled}"
                                  Visibility="{Binding IsCaptureDisabled, Converter={StaticResource BoolToVisibility}}"
                                  Style="{StaticResource ClipboardHistoryConsentCheckBox}"
                                  Margin="0,10,0,8">
                            <TextBlock Text="I understand clipboard text may contain sensitive information and consent to storing it encrypted on this device."
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <WrapPanel>
                            <Button Content="Start capture"
                                    Command="{Binding StartCaptureCommand}"
                                    IsEnabled="{Binding CanStartCapture}"
                                    Style="{StaticResource ClipboardHistoryPrimaryButton}"
                                    Visibility="{Binding IsCaptureDisabled, Converter={StaticResource BoolToVisibility}}" 
                                    Margin="0,20,0,0"
                                    FontWeight="SemiBold"/>
                            <Button Content="Pause"
                                    Command="{Binding PauseCaptureCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Margin="0,1,0,0"
                                    Style="{StaticResource ClipboardHistoryButton}"
                                    Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Resume"
                                    Command="{Binding ResumeCaptureCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ClipboardHistoryPrimaryButton}"
                                    Margin="0,1,0,0"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Stop and disable"
                                    Command="{Binding DisableCaptureCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource WarningActionButton}"
                                    Height="36"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Stop and disable"
                                    Command="{Binding DisableCaptureCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource WarningActionButton}"
                                    
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Storage policy"
                                   Style="{StaticResource ClipboardHistoryPolicyHeading}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource ClipboardHistoryPolicyTile}">
                                <StackPanel>
                                    <TextBlock Text="Captured content"
                                               Style="{StaticResource ClipboardHistoryPolicyLabel}" />
                                    <TextBlock Text="Plain text only"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ClipboardHistoryPolicyValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource ClipboardHistoryPolicyTile}">
                                <StackPanel>
                                    <TextBlock Text="Retention"
                                               Style="{StaticResource ClipboardHistoryPolicyLabel}" />
                                    <TextBlock Text="90 days"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ClipboardHistoryPolicyValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource ClipboardHistoryPolicyTile}">
                                <StackPanel>
                                    <TextBlock Text="History limit"
                                               Style="{StaticResource ClipboardHistoryPolicyLabel}" />
                                    <TextBlock Text="5,000 entries"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ClipboardHistoryPolicyValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource ClipboardHistoryPolicyTile}">
                                <StackPanel>
                                    <TextBlock Text="Per-entry size"
                                               Style="{StaticResource ClipboardHistoryPolicyLabel}" />
                                    <TextBlock Text="1 MB maximum"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ClipboardHistoryPolicyValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource ClipboardHistoryPolicyTile}">
                                <StackPanel>
                                    <TextBlock Text="Storage limit"
                                               Style="{StaticResource ClipboardHistoryPolicyLabel}" />
                                    <TextBlock Text="100 MB maximum"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ClipboardHistoryPolicyValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="2"
                                    Style="{StaticResource ClipboardHistoryPolicyTile}">
                                <StackPanel>
                                    <TextBlock Text="Pinned entries"
                                               Style="{StaticResource ClipboardHistoryPolicyLabel}" />
                                    <TextBlock Text="Skip age cleanup; count toward limits"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource ClipboardHistoryPolicyValue}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="{DynamicResource AmberTintBrush}"
                                BorderBrush="{DynamicResource WarmOutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="4,8,4,0">
                            <StackPanel>
                                <TextBlock Text="When limits are reached"
                                           Style="{StaticResource ClipboardHistoryPolicyNoteHeading}" />
                                <TextBlock Text="The oldest unpinned entries are removed to make room. If all entries are pinned, new clipboard text is skipped. Text over 1 MB is not saved."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource ClipboardHistoryPolicyNote}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding StoragePath}"
                           Margin="0,8,0,0"
                           FontFamily="Consolas"
                           Style="{StaticResource ClipboardHistoryCaption}"
                           ToolTip="{Binding StoragePath}" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="History"
                               Margin="0,8,0,20"
                               Style="{StaticResource ClipboardHistorySectionTitle}" />
                <DockPanel Margin="0,0,0,12">

                    <ComboBox DockPanel.Dock="Left"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                              Style="{StaticResource ClipboardHistorySortComboBox}"
                              Margin="0,0,8,0"
                              ToolTip="Sort clipboard history"
                              AutomationProperties.Name="Sort clipboard history">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding HistoryCountSummary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource ClipboardHistoryCaption}" />

                    <Button DockPanel.Dock="Right"
                            Content="Clear all"
                            Width="150"
                            Command="{Binding ClearAllCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource WarningActionButton}"
                            Margin="8,0,0,0" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="42"
                            Background="{DynamicResource CardSurfaceBrush}"
                            BorderBrush="{DynamicResource CardOutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="21"
                            Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕"
                                       FontSize="20"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ClipboardHistorySearchBox}"
                                         ToolTip="Search captured text"
                                         AutomationProperties.Name="Search clipboard history" />
                                <TextBlock Text="Search clipboard history..."
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1"
                            Style="{StaticResource ClipboardHistoryClearSearchButton}"
                            Margin="8,0,0,0"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="Clear search"
                            AutomationProperties.Name="Clear clipboard history search">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="#3B2B0D"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>
                </Grid>
                <TextBlock Text="No clipboard entries are stored."
                           Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,12,0,0"
                           Style="{StaticResource ClipboardHistoryCaption}" />
                <TextBlock Text="No entries match the current search."
                           Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,12,0,0"
                           Style="{StaticResource ClipboardHistoryCaption}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                        Background="{DynamicResource CardSurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            ClipToBounds="True"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasFilteredEntries, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="155" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Clipboard"
                                           Style="{StaticResource ClipboardHistoryFieldLabel}" />
                                <TextBlock Grid.Column="1"
                                           Text="Date &amp; time"
                                           TextAlignment="Right"
                                           Style="{StaticResource ClipboardHistoryFieldLabel}" />
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredEntries}"
                                 SelectedItem="{Binding SelectedListEntry, Mode=TwoWay}"
                                 Style="{StaticResource ClipboardHistoryList}"
                                 ItemContainerStyle="{StaticResource ClipboardHistoryListItem}"
                                 AutomationProperties.Name="Clipboard history table">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="155" />
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Text, Converter={StaticResource ClipboardHistoryTitleConverter}}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, Converter={StaticResource ClipboardHistoryTitleConverter}}"
                                                           Style="{StaticResource ClipboardHistoryEntryText}" />
                                                <Border Style="{StaticResource ClipboardHistorySizeTag}">
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Size of stored clipboard text">
                                                        <Path Data="M12,2 L21,6.5 L12,11 L3,6.5 Z M3,11.5 L12,16 L21,11.5 M3,16.5 L12,21 L21,16.5"
                                                              Width="11"
                                                              Height="11"
                                                              Margin="0,0,5,0"
                                                              Stretch="Uniform"
                                                              Stroke="{DynamicResource AmberDeepBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Utf8ByteCount, Converter={StaticResource ClipboardHistorySizeConverter}}"
                                                                   Style="{StaticResource ClipboardHistorySizeTagText}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="18"
                                                    Height="18"
                                                    CornerRadius="9"
                                                    Background="{DynamicResource AmberTintBrush}"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Pinned entry">
                                                <Path Data="M8,3 H16 L15,7 L18,10 V11 H13 V17 L12,18 L11,17 V11 H6 V10 L9,7 Z M12,18 V22"
                                                      Width="11"
                                                      Height="11"
                                                      Fill="{DynamicResource AmberDeepBrush}"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   TextWrapping="NoWrap"
                                                   Style="{StaticResource ClipboardHistoryCaption}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Selected text"
                                       Style="{StaticResource ClipboardHistoryFieldLabel}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="20,1,0,0"
                                       Text="{Binding SelectedEntry.CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                       Style="{StaticResource ClipboardHistoryCaption}" />
                        </DockPanel>
                        <TextBox Text="{Binding SelectedEntry.Text, Mode=OneWay}"
                                 Style="{StaticResource ClipboardHistoryTextEditor}"
                                 Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Selected clipboard text" />
                        <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                MinHeight="120"
                                Visibility="{Binding HasNoSelectedEntry, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Select an entry to preview"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Captured text stays encrypted at rest and is shown here only after selection."
                                           Margin="0,5,0,0"
                                           Style="{StaticResource ClipboardHistoryCaption}" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Copy"
                                    Command="{Binding CopySelectedCommand}"
                                    IsEnabled="{Binding CanUseSelectedEntry}"
                                    Style="{StaticResource ClipboardHistoryButton}"
                                    Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding SelectedEntryPinAction}"
                                    Command="{Binding TogglePinSelectedCommand}"
                                    IsEnabled="{Binding CanUseSelectedEntry}"
                                    Style="{StaticResource ClipboardHistoryButton}"
                                    Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Delete entry"
                                    Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding CanUseSelectedEntry}"
                                    Style="{StaticResource ClipboardHistoryButton}"
                                    Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <Border Style="{StaticResource ClipboardHistoryActionFeedbackSurface}"
                                Visibility="{Binding HasActionFeedback, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ActionFeedback}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource ClipboardHistoryActionFeedbackText}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
