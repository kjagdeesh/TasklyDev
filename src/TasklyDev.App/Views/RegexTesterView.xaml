<UserControl x:Class="TasklyDev.Views.RegexTesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="RegexActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegexPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource RegexActionButton}">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RegexEditor" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegexSampleEditor" TargetType="TextBox" BasedOn="{StaticResource RegexEditor}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="RegexFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="RegexOptionCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckContainer"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CheckIndicator"
                                        Width="17"
                                        Height="17"
                                        CornerRadius="5"
                                        Background="{DynamicResource CardSurfaceBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Data="M 3 8 L 6.5 11.5 L 13 4.5"
                                          Width="11"
                                          Height="9"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource PrimaryTextBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckContainer" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIndicator" Property="Background" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="CheckIndicator" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckContainer" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter TargetName="CheckContainer" Property="BorderBrush" Value="{DynamicResource WarmOutlineBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckContainer" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RegexMatchTemplate">
            <Border Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="13"
                    Margin="0,0,0,9">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AmberTintBrush}"
                                CornerRadius="8"
                                Padding="8,4"
                                VerticalAlignment="Top">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AmberDeepBrush}">
                                <Run Text="Index " />
                                <Run Text="{Binding Index}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Value}"
                                   Margin="11,3,0,0"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Margin="0,7,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}">
                        <Run Text="Length: " />
                        <Run Text="{Binding Length}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Groups}"
                                  Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}"
                                               Width="70"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Value}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Pattern"
                           Style="{StaticResource RegexFieldLabel}"
                           Margin="0,0,0,7" />
                <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotBusy}"
                         Style="{StaticResource RegexEditor}"
                         AutomationProperties.Name="Regular expression pattern" />
                <TextBlock Text="Sample text"
                           Style="{StaticResource RegexFieldLabel}"
                           Margin="0,15,0,7" />
                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotBusy}"
                         Style="{StaticResource RegexSampleEditor}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Regular expression sample text" />

                <WrapPanel Margin="0,14,0,0">
                    <CheckBox Content="Ignore Case"
                              IsChecked="{Binding IgnoreCase}"
                              IsEnabled="{Binding IsNotBusy}"
                              Margin="0,0,10,8"
                              Style="{StaticResource RegexOptionCheckBox}"
                              AutomationProperties.Name="Ignore case" />
                    <CheckBox Content="Multiline"
                              IsChecked="{Binding Multiline}"
                              IsEnabled="{Binding IsNotBusy}"
                              Margin="0,0,10,8"
                              Style="{StaticResource RegexOptionCheckBox}"
                              AutomationProperties.Name="Multiline option" />
                    <CheckBox Content="Singleline"
                              IsChecked="{Binding Singleline}"
                              IsEnabled="{Binding IsNotBusy}"
                              Margin="0,0,0,8"
                              Style="{StaticResource RegexOptionCheckBox}"
                              AutomationProperties.Name="Singleline option" />
                </WrapPanel>

                <DockPanel Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test pattern"
                                Command="{Binding TestCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource RegexPrimaryActionButton}"
                                FontWeight="SemiBold"
                                AutomationProperties.Name="Test regular expression" />
                        <Button Content="Load sample"
                                Command="{Binding LoadSampleCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="8,0,0,0"
                                Style="{StaticResource RegexActionButton}" />
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="8,0,0,0"
                                Style="{StaticResource WarningActionButton}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Margin="20,0,0,0"
                               Text="Finite 250 ms match timeout"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
                <Border CornerRadius="10"
                        Padding="12,9"
                        Margin="0,11,0,0"
                        AutomationProperties.LiveSetting="Polite">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Margin="2,0,0,10">
            <TextBlock Text="Matches"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding Matches.Count, StringFormat={}{0} shown}"
                       FontSize="11"
                       Margin="20,2,0,0"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Matches}"
                      ItemTemplate="{StaticResource RegexMatchTemplate}">
            <ItemsControl.Visibility>
                <Binding Path="HasMatches" Converter="{StaticResource BoolToVisibility}" />
            </ItemsControl.Visibility>
        </ItemsControl>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                CornerRadius="14"
                Padding="18"
                Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No matches found."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
        <Border Background="{DynamicResource AmberTintBrush}"
                CornerRadius="10"
                Padding="12,9"
                Margin="0,4,0,0"
                Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Only the first 100 matches are shown."
                       Foreground="{DynamicResource AmberDeepBrush}"
                       FontSize="12" />
        </Border>
    </StackPanel>
</UserControl>
