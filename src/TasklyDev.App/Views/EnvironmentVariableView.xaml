<UserControl x:Class="TasklyDev.Views.EnvironmentVariableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="EnvironmentGridColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="EnvironmentGridRow" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Environment Variables"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Browse variables from the current process or Windows user and machine scopes."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="14,0,0,0"
                            Padding="14,9"
                            Background="{DynamicResource AmberBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            AutomationProperties.Name="Refresh environment variables" />
                </DockPanel>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Scope"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7" />
                        <ComboBox ItemsSource="{Binding Scopes}"
                                  SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                                  Padding="9,8"
                                  IsEnabled="{Binding IsNotBusy}"
                                  AutomationProperties.Name="Environment variable scope" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Search name or value"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="38"
                                 Padding="10,7"
                                 Background="{DynamicResource EditorSurfaceBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource OutlineBrush}"
                                 BorderThickness="1"
                                 AutomationProperties.Name="Search environment variable name or value" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,10,0,0"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="4"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <ListView ItemsSource="{Binding Variables}"
                      SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource EnvironmentGridRow}"
                      BorderThickness="0"
                      MaxHeight="390"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Environment variable results">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource EnvironmentGridColumnHeader}">
                        <GridViewColumn Header="Name" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Value (preview)" Width="540">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="520"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                CornerRadius="14"
                Padding="18"
                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No environment variables match this search."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="0,14,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding SelectedVariable.Name}"
                               FontFamily="Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="Copy full value"
                            Command="{Binding CopyValueCommand}"
                            Padding="11,6"
                            Style="{StaticResource SecondaryActionButton}" />
                </DockPanel>
                <TextBox Text="{Binding SelectedValue, Mode=OneWay}"
                         IsReadOnly="True"
                         MinHeight="62"
                         MaxHeight="150"
                         Padding="10"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource SubtleSurfaceBrush}"
                         BorderBrush="{DynamicResource OutlineBrush}"
                         AutomationProperties.Name="Full selected environment variable value" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource AmberTintBrush}"
                CornerRadius="10"
                Padding="12,9"
                Margin="0,14,0,0">
            <TextBlock Text="Environment variables can contain credentials, tokens, or private paths. Review values carefully before sharing. TasklyDev does not edit or persist them."
                       Foreground="{DynamicResource AmberDeepBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
