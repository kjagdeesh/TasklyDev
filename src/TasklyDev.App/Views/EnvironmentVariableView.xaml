<UserControl x:Class="TasklyDev.Views.EnvironmentVariableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             IsVisibleChanged="EnvironmentVariableView_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="EnvironmentActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EnvironmentPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource EnvironmentActionButton}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource WarmOutlineBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EnvironmentEditor" TargetType="TextBox">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Background="Transparent"
                                              Focusable="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocused" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EnvironmentSearchEditor" TargetType="TextBox" BasedOn="{StaticResource EnvironmentEditor}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="EnvironmentValueEditor" TargetType="TextBox" BasedOn="{StaticResource EnvironmentEditor}">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="MaxHeight" Value="160" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        </Style>
        <Style x:Key="EnvironmentSortHeaderButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AmberDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EnvironmentResultListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AmberTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="EnvironmentRowTemplate">
            <Border BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10"
                    MinHeight="54">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardOutlineBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Environment Variables"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Browse variables from the current process or Windows user and machine scopes."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="14,0,0,0"
                            Width="126"
                            Style="{StaticResource EnvironmentPrimaryActionButton}"
                            ToolTip="Reload the environment variables for the selected scope"
                            AutomationProperties.Name="Refresh environment variables">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Refresh" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="Refreshing..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Scope"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,7" />
                        <ComboBox ItemsSource="{Binding Scopes}"
                                  SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                                  Padding="9,8"
                                  IsEnabled="{Binding IsNotBusy}"
                                  AutomationProperties.Name="Environment variable scope" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Search name or value"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,7" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EnvironmentSearchEditor}"
                                 Tag="Search variable name or value…"
                                 AutomationProperties.Name="Search environment variable name or value" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource RoundedStatusMessageBorder}"
                        Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource AmberTintBrush}"
                CornerRadius="10"
                Padding="12,9"
                Margin="0,0,0,15">
            <TextBlock Text="Environment variables can contain credentials, tokens, or private paths. Review values carefully before sharing. TasklyDev does not edit or persist them."
               Foreground="{DynamicResource AmberDeepBrush}"
               FontSize="12"
               TextWrapping="Wrap" />
        </Border>

        <DockPanel Margin="2,0,2,8"
                   Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Environment variable results"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock DockPanel.Dock="Right"
                       FontSize="11"
                       Margin="20,2,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Showing {0} of {1} variables">
                        <Binding Path="Variables.Count" />
                        <Binding Path="SnapshotCount" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DockPanel>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SubtleSurfaceBrush}"
                        CornerRadius="9"
                        Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EnvironmentNameHeader" Content="Name  ↕" Tag="Name" Click="EnvironmentGridHeader_Click"
                                Style="{StaticResource EnvironmentSortHeaderButton}" />
                        <Button x:Name="EnvironmentValueHeader" Grid.Column="1" Content="Value (preview)  ↕" Tag="Value" Click="EnvironmentGridHeader_Click"
                                Style="{StaticResource EnvironmentSortHeaderButton}" />
                    </Grid>
                </Border>
                <ListBox x:Name="EnvironmentVariableList"
                         Grid.Row="1"
                         ItemsSource="{Binding Variables}"
                         SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                         ItemTemplate="{StaticResource EnvironmentRowTemplate}"
                         ItemContainerStyle="{StaticResource EnvironmentResultListItem}"
                         Background="{DynamicResource CardSurfaceBrush}"
                         BorderThickness="0"
                         MaxHeight="390"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Environment variable results" />
            </Grid>
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                CornerRadius="14"
                Padding="18"
                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No environment variables match this search."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Border>

        <Border Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="0,14,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding SelectedVariable.Name}"
                               FontFamily="Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="Copy full value"
                            Command="{Binding CopyValueCommand}"
                            Style="{StaticResource EnvironmentActionButton}" />
                </DockPanel>
                <TextBox Text="{Binding SelectedValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Style="{StaticResource EnvironmentValueEditor}"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Full selected environment variable value" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
