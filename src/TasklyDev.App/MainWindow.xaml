<Window x:Class="TasklyDev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TasklyDev.Views"
        Title="taskly.dev"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Width="1320"
        Height="880"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowSurfaceBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Geometry x:Key="HomeIconGeometry">M3 11 L12 3 L21 11 M5.5 10.5 V17.5 A3 3 0 0 0 8.5 20.5 H10 V14.5 A2 2 0 0 1 14 14.5 V20.5 H15.5 A3 3 0 0 0 18.5 17.5 V10.5</Geometry>
        <Geometry x:Key="Base64IconGeometry">M6 3.5 H15 L19 7.5 V20.5 H6 Z M15 3.5 V8 H19 M9 12 L7.5 14 L9 16 M12 16 L14 12 M17 12 L15.5 14 L17 16</Geometry>
        <Geometry x:Key="NumberBaseIconGeometry">M5 3.5 H19 V20.5 H5 Z M8 7 H16 M8 11 H10 M14 11 H16 M8 15 H10 M14 15 H16 M8 18 H10 M14 18 H16</Geometry>
        <Geometry x:Key="TimestampIconGeometry">M12 3.5 A8.5 8.5 0 1 0 12 20.5 A8.5 8.5 0 1 0 12 3.5 Z M12 7 V12 L15.5 14</Geometry>
        <Geometry x:Key="GuidIconGeometry">M4 5 H20 V19 H4 Z M9 10 A2 2 0 1 0 9 14 A2 2 0 1 0 9 10 Z M13 11 H17 M13 14 H17</Geometry>
        <Geometry x:Key="GuidParserIconGeometry">M5 4 H19 V20 H5 Z M8 9 L10 11 L14 7 M8 15 H16 M8 17.5 H13</Geometry>
        <Geometry x:Key="UrlIconGeometry">M9.5 14.5 L14.5 9.5 M7.5 16.5 L5.8 18.2 A3.2 3.2 0 0 1 1.3 13.7 L5.5 9.5 A3.2 3.2 0 0 1 10 9.5 M16.5 7.5 L18.2 5.8 A3.2 3.2 0 0 1 22.7 10.3 L18.5 14.5 A3.2 3.2 0 0 1 14 14.5</Geometry>
        <Geometry x:Key="JwtIconGeometry">M12 3 L19 6 V11 C19 15.5 16 19 12 21 C8 19 5 15.5 5 11 V6 Z M9 10 H15 M9 13 H15 M9 16 H13</Geometry>
        <Geometry x:Key="HashIconGeometry">M9 4 L7 20 M17 4 L15 20 M4 9 H20 M3 15 H19</Geometry>
        <Geometry x:Key="ColorIconGeometry">M12 3.5 C7.2 3.5 3.5 7.2 3.5 12 C3.5 16.7 7.3 20.5 12 20.5 H14.2 C16.2 20.5 16.8 18.2 15.4 16.9 C14.2 15.8 15 13.8 16.6 13.8 H18.2 C19.6 13.8 20.5 12.8 20.5 11.4 C20.5 7 16.7 3.5 12 3.5 Z M8 9 A1 1 0 1 0 8 11 A1 1 0 1 0 8 9 Z M12 6.5 A1 1 0 1 0 12 8.5 A1 1 0 1 0 12 6.5 Z M16 8.5 A1 1 0 1 0 16 10.5 A1 1 0 1 0 16 8.5 Z</Geometry>
        <Geometry x:Key="RegexIconGeometry">M7 4 H5 V20 H7 M17 4 H19 V20 H17 M9 13 L12 7 L15 13 M12 15 V20 M9 16.5 L15 19 M15 16.5 L9 19</Geometry>
        <Geometry x:Key="ProcessIconGeometry">M4 4 H20 V17 H4 Z M8 21 H16 M12 17 V21 M7 13 L10 10 L13 12 L17 7</Geometry>
        <Geometry x:Key="EnvironmentIconGeometry">M4 5 H20 V19 H4 Z M7 9 L10 12 L7 15 M12 15 H17</Geometry>
        <Geometry x:Key="DotNetIconGeometry">M4 5 H20 V19 H4 Z M7 9 H10 M7 12 H10 M7 15 H10 M13 9 L17 15 M17 9 L13 15</Geometry>
        <Geometry x:Key="SystemInfoIconGeometry">M3 4 H21 V17 H3 Z M8 21 H16 M12 17 V21 M8 8 H16 M8 11 H16 M8 14 H13</Geometry>
        <Geometry x:Key="ClipboardHistoryIconGeometry">M8 4 H5 V21 H19 V4 H16 M9 3 H15 V7 H9 Z M8 11 H16 M8 14 H16 M8 17 H13</Geometry>
        <Geometry x:Key="CertificateIconGeometry">M6 3.5 H18 V20.5 L12 17.5 L6 20.5 Z M9 8 H15 M9 11 H15 M9 14 H13</Geometry>
        <Geometry x:Key="SettingsIconGeometry">M12 8.5 A3.5 3.5 0 1 0 12 15.5 A3.5 3.5 0 1 0 12 8.5 Z M12 3 V5 M12 19 V21 M3 12 H5 M19 12 H21 M5.6 5.6 L7 7 M17 17 L18.4 18.4 M18.4 5.6 L17 7 M7 17 L5.6 18.4</Geometry>
        <Style x:Key="RouteIconPath" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource Base64IconGeometry}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource AmberDeepBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="number-base">
                    <Setter Property="Data" Value="{StaticResource NumberBaseIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="timestamp">
                    <Setter Property="Data" Value="{StaticResource TimestampIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="guid">
                    <Setter Property="Data" Value="{StaticResource GuidIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="uuid-parser">
                    <Setter Property="Data" Value="{StaticResource GuidParserIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="url-codec">
                    <Setter Property="Data" Value="{StaticResource UrlIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="jwt-decoder">
                    <Setter Property="Data" Value="{StaticResource JwtIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="hash">
                    <Setter Property="Data" Value="{StaticResource HashIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="color">
                    <Setter Property="Data" Value="{StaticResource ColorIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="regex">
                    <Setter Property="Data" Value="{StaticResource RegexIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="process">
                    <Setter Property="Data" Value="{StaticResource ProcessIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="environment">
                    <Setter Property="Data" Value="{StaticResource EnvironmentIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="dotnet-inspector">
                    <Setter Property="Data" Value="{StaticResource DotNetIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="system-info">
                    <Setter Property="Data" Value="{StaticResource SystemInfoIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="clipboard-history">
                    <Setter Property="Data" Value="{StaticResource ClipboardHistoryIconGeometry}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="certificate-inspector">
                    <Setter Property="Data" Value="{StaticResource CertificateIconGeometry}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="NavigationItemTemplate">
            <Button Command="{Binding DataContext.OpenRouteCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding Route}"
                    ToolTip="{Binding Title}"
                    AutomationProperties.Name="{Binding Title}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButton}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{DynamicResource AmberTintBrush}"
                            HorizontalAlignment="Left">
                        <Path Width="16"
                              Height="16"
                              Tag="{Binding Route}"
                              Style="{StaticResource RouteIconPath}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Ellipse Grid.Column="2"
                             Width="7"
                             Height="7"
                             Fill="{DynamicResource AmberBrush}"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ToolCardTemplate">
            <Button Style="{StaticResource ToolCardButton}"
                    Margin="0,0,12,12"
                    MinHeight="112"
                    Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding Route}"
                    AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40"
                            Height="40"
                            CornerRadius="14"
                            Background="{DynamicResource AmberTintBrush}"
                            VerticalAlignment="Top">
                        <Path Width="22"
                              Height="22"
                              Tag="{Binding Route}"
                              Style="{StaticResource RouteIconPath}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,1,0,0">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="0"
            CornerRadius="28"
            Background="{DynamicResource WindowSurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="0">
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22,24,18,18"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,2,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32"
                                Height="32">
                            <Image x:Name="BrandLogo"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Loaded="BrandLogo_Loaded"
                                   AutomationProperties.Name="Taskly.dev logo" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="8,0,5,0"
                                   FontSize="21"
                                   FontWeight="Bold">
                            <Run Text="taskly" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Run Text=".dev" Foreground="{DynamicResource AmberBrush}" />
                        </TextBlock>
                        <Border Grid.Column="2"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                CornerRadius="12"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SettingsViewModel.Version, StringFormat=v{0}}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>
                    </Grid>

                    <Button Grid.Row="1"
                            Command="{Binding OpenRouteCommand}"
                            CommandParameter="home"
                            ToolTip="Overview">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButton}">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverviewNavigation.IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="{DynamicResource AmberTintBrush}"
                                    Margin="0,0,2,0">
                                <Path Data="{StaticResource HomeIconGeometry}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource AmberDeepBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Overview" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,20,0,8"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="DEVELOPER TOOLS"
                                       Margin="12,0,0,7"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <ItemsControl ItemsSource="{Binding DeveloperNavigation}"
                                          ItemTemplate="{StaticResource NavigationItemTemplate}" />
                            <TextBlock Text="SYSTEM DIAGNOSTICS"
                                       Margin="12,18,0,7"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <ItemsControl ItemsSource="{Binding SystemNavigation}"
                                          ItemTemplate="{StaticResource NavigationItemTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <Button
                                Command="{Binding OpenRouteCommand}"
                                CommandParameter="settings"
                                ToolTip="Preferences">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsNavigation.IsActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="{DynamicResource AmberTintBrush}"
                                        Margin="0,0,2,0">
                                    <Path Data="{StaticResource SettingsIconGeometry}"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AmberDeepBrush}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Preferences" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="32,26,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   Margin="0,5,12,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="42"
                                Background="{DynamicResource CardSurfaceBrush}"
                                BorderBrush="{DynamicResource CardOutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="21"
                                Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⌕"
                                           FontSize="20"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             FontSize="12"
                                             ToolTip="Search tools by name or description"
                                             AutomationProperties.Name="Search tools" />
                                    <TextBlock Text="Search tools by name or description..."
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1"
                                Width="42"
                                Height="42"
                                Margin="10,0,0,0"
                                Background="{DynamicResource AmberBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="0"
                                FontSize="21"
                                FontWeight="Light"
                                Content="×"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="Clear search"
                                AutomationProperties.Name="Clear tool search">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Find the right tool for the task"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />
                            <TextBlock Text="Everything is designed to run locally. Choose a tool to open its workspace."
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,22" />

                            <StackPanel Visibility="{Binding HasDeveloperTools, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Developer tools"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding DeveloperTools}"
                                              ItemTemplate="{StaticResource ToolCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasSystemTools, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="System diagnostics"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding SystemTools}"
                                              ItemTemplate="{StaticResource ToolCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <Border Padding="20"
                                    Background="{DynamicResource CardSurfaceBrush}"
                                    CornerRadius="18"
                                    Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="No matching tools"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Try a different name or a keyword such as “date”, “hash”, or “process”."
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ContentControl Content="{Binding Base64ViewModel}"
                                        Visibility="{Binding IsBase64, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:Base64View />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding NumberBaseViewModel}"
                                        Visibility="{Binding IsNumberBase, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:NumberBaseView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding UnixTimestampViewModel}"
                                        Visibility="{Binding IsTimestamp, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:UnixTimestampView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding GuidGeneratorViewModel}"
                                        Visibility="{Binding IsGuidGenerator, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:GuidGeneratorView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding GuidParserViewModel}"
                                        Visibility="{Binding IsGuidParser, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:GuidParserView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding UrlCodecViewModel}"
                                        Visibility="{Binding IsUrlCodec, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:UrlCodecView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding JwtDecoderViewModel}"
                                        Visibility="{Binding IsJwtDecoder, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:JwtDecoderView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding HashCalculatorViewModel}"
                                        Visibility="{Binding IsHashCalculator, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:HashCalculatorView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding ColorConverterViewModel}"
                                        Visibility="{Binding IsColorConverter, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:ColorConverterView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding RegexTesterViewModel}"
                                        Visibility="{Binding IsRegexTester, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:RegexTesterView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding ProcessLookupViewModel}"
                                        Visibility="{Binding IsProcessLookup, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:ProcessLookupView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding EnvironmentVariableViewModel}"
                                        Visibility="{Binding IsEnvironmentVariables, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:EnvironmentVariableView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding DotNetInspectorViewModel}"
                                        Visibility="{Binding IsDotNetInspector, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:DotNetInspectorView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding SystemInformationViewModel}"
                                        Visibility="{Binding IsSystemInformation, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:SystemInformationView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding ClipboardHistoryViewModel}"
                                        Visibility="{Binding IsClipboardHistory, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:ClipboardHistoryView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding CertificateInspectorViewModel}"
                                        Visibility="{Binding IsCertificateInspector, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:CertificateInspectorView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ContentControl Content="{Binding SettingsViewModel}"
                                        Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:SettingsView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <Border Padding="24"
                                Background="{DynamicResource CardSurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="16"
                                        Background="{DynamicResource AmberTintBrush}"
                                        HorizontalAlignment="Left">
                                    <Path Width="24"
                                          Height="24"
                                          Tag="{Binding CurrentTool.Route}"
                                          Style="{StaticResource RouteIconPath}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding CurrentPageTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,18,0,6" />
                                <TextBlock Text="{Binding CurrentPageSubtitle}"
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <Border Background="{DynamicResource AmberTintBrush}"
                                        CornerRadius="10"
                                        Padding="12,9"
                                        Margin="0,20,0,0"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="Workspace shell is ready — tool functionality will be added in its module."
                                               Foreground="{DynamicResource AmberDeepBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--<DockPanel Grid.Row="2"
                           Margin="0,14,0,0"
                           LastChildFill="False">
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="8,0,5,0"
                               FontSize="12"
                               FontWeight="Bold">
                        <Run Text="taskly" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Run Text=".dev" Foreground="{DynamicResource AmberBrush}" />
                    </TextBlock>
                </DockPanel>-->
            </Grid>
        </Grid>
    </Border>
</Window>
