<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- UpgradeCode identifies Taskly.Dev across versions. Never change it, or upgrades will install side by side. -->
  <Package Name="Taskly.Dev"
           Manufacturer="Taskly.Dev"
           Version="$(Version)"
           UpgradeCode="6B2F3A54-8D1E-4C77-9A0B-5E4D2C91F7A3"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Taskly.Dev is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Every published file is added automatically, so new app files never need installer edits. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**" />
    </ComponentGroup>

    <Feature Id="Main" Title="Taskly.Dev" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Taskly.Dev" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="3C8E1D92-47A5-4B6F-B0D3-91A2E5F68C14">
        <Shortcut Id="StartMenuShortcutEntry"
                  Name="Taskly.Dev"
                  Description="Developer and system-diagnostic tools"
                  Target="[INSTALLFOLDER]TasklyDev.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\Taskly.Dev"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
